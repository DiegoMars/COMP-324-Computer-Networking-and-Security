</head>
<body class="login">

<style>
body.login {
  background:
    linear-gradient(rgba(64, 43, 16, 0.34), rgba(64, 43, 16, 0.34)),
    url("/assets/csun-login-background-2026.jpg") center center / cover fixed no-repeat;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 64px;
}

#bwrapper {
  background-color: transparent;
  background-image: none;
}

#bwrapper {
  margin: 0 auto;
  max-width: 960px;
  padding: 28px 16px 40px;
  width: 100%;
}

.page-policy-bar {
  align-items: center;
  background: #111111;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  left: 0;
  min-height: 52px;
  padding: 10px 24px;
  position: fixed;
  right: 0;
  z-index: 20;
}

.page-policy-bar .page-policy-link,
.page-policy-bar .page-policy-link:visited,
.page-policy-bar .page-policy-link:hover,
.page-policy-bar .page-policy-link:active {
  color: #ffffff !important;
  display: inline-block;
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.4;
  text-decoration: underline;
  text-decoration-color: #ffffff;
}

.page-policy-bar .page-policy-link:focus-visible {
  background: #111111;
  color: #ffffff !important;
  outline: 3px solid #ffffff;
  outline-offset: 3px;
  text-decoration-thickness: 2px;
}

#coltwo {
  float: none;
  width: min(100%, 560px);
  margin: 0 auto 24px auto;
}

.login-panel {
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid #b8b8b8;
  box-sizing: border-box;
  box-shadow: 0 28px 60px rgba(0, 0, 0, 0.18);
  color: #111111;
  display: flow-root;
  padding: 28px 28px 24px;
}

.login-panel-brand {
  display: flex;
  justify-content: center;
  margin: 0 0 20px 0;
}

.login-panel-brand img {
  display: block;
  height: auto;
  margin: 0;
  max-width: min(100%, 280px);
}

.login-panel h1 {
  border-bottom: none;
  color: #111111;
  font-size: 2rem;
  margin: 0 0 24px 0;
  text-align: left;
}

.login-panel-copy {
  background: transparent;
  box-sizing: border-box;
  clear: both;
  color: #111111;
  display: block;
  width: 100%;
}

.sr-only-focusable:focus {
  background: #ffffff;
  clip: auto;
  color: #111111;
  height: auto;
  left: 16px;
  padding: 8px 12px;
  top: 16px;
  width: auto;
  z-index: 1000;
}

.login-panel-copy {
  border-top: 1px solid #d7d7d7;
  margin-top: 24px;
  padding-top: 18px;
  text-align: left;
}

.login-panel-copy p {
  color: #111111;
  font-size: 0.95rem;
  line-height: 1.5;
  margin: 0;
}

.login-content {
  margin: 0;
  padding: 0;
}

.login-column {
  float: none;
  margin: 0;
  width: 100%;
}

form.pageForm.login-form {
  margin: 0;
  max-width: none;
  min-width: 0;
  width: 100%;
}

.login-field {
  margin: 0 0 22px 0;
}

form.pageForm.login-form label {
  color: #111111;
  display: block;
  float: none;
  font-weight: 700;
  margin: 0 0 8px 0;
  text-align: left;
  width: auto;
}

.underline-input,
.input-with-button {
  background: #ffffff;
  border-bottom: 2px solid #666666;
  box-sizing: border-box;
  display: flex;
  width: 100%;
}

.underline-input {
  align-items: center;
  min-height: 48px;
}

form.pageForm.login-form input[type="text"],
form.pageForm.login-form input[type="password"] {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  color: #111111;
  font-size: 1rem;
  margin: 0;
  min-height: 40px;
  padding: 8px 0 10px 0;
  width: 100%;
}

form.pageForm.login-form input[type="text"] {
  padding-left: 0;
}

form.pageForm.login-form input[type="password"] {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 0;
  width: auto;
}

.sr-only {
  border: 0;
  clip: rect(0 0 0 0);
  height: 1px;
  margin: -1px;
  overflow: hidden;
  padding: 0;
  position: absolute;
  width: 1px;
}

.input-with-button {
  align-items: center;
  flex-wrap: nowrap;
  gap: 12px;
  left: 0;
  min-height: 48px;
  overflow: hidden;
  position: relative;
  top: 0;
  width: 100%;
}

.pwshowbutton {
  align-items: center;
  background: #ffffff;
  border: 1px solid #111111;
  border-radius: 2px;
  color: #111111;
  cursor: pointer;
  display: inline-flex;
  flex: 0 0 auto;
  height: 36px;
  justify-content: center;
  min-width: 44px;
  margin-bottom: 4px;
  padding: 4px 12px;
  position: static;
  transform: none;
}

.pwshowlabel {
  font-size: 0.875rem;
  font-weight: 700;
  line-height: 1.1;
}

.login-submit {
  display: flex;
  justify-content: flex-start;
  margin-top: 24px;
}

.login-actions {
  align-items: flex-start;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

button.submitButton {
  background: #b00020;
  border: 2px solid #8a0017;
  border-radius: 4px;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  min-height: 48px;
  min-width: 168px;
  padding: 12px 24px;
}

button.submitButton:hover,
button.submitButton:active {
  background: #8f001a;
  color: #ffffff;
}

.forgot-password-link {
  color: #7a0019;
  font-weight: 700;
  text-decoration: underline;
}

.underline-input:focus-within,
.input-with-button:focus-within {
  border-bottom-color: #b00020;
  outline: 3px solid #005fcc;
  outline-offset: 4px;
}

.pwshowbutton:focus-visible,
button.submitButton:focus-visible,
a:focus-visible {
  outline: 3px solid #005fcc;
  outline-offset: 3px;
}

form.pageForm.login-form input:focus-visible {
  outline: none;
}

.pwshowbutton:hover {
  background: #f2f2f2;
}

@media only screen and (max-width: 960px) {
  body.login {
    background-attachment: scroll;
  }

  #bwrapper {
    padding: 20px 12px 28px;
  }

  .page-policy-bar {
    min-height: 56px;
    padding: 10px 16px;
  }

  #coltwo {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .login-panel {
    padding: 24px 18px 20px;
  }

  .login-panel h1 {
    font-size: 1.75rem;
  }

  .login-panel-brand {
    margin-bottom: 16px;
  }

  .login-panel-brand img {
    max-width: min(100%, 240px);
  }

  form.pageForm.login-form label {
    font-size: 1rem;
    text-align: left;
  }

  .input-with-button {
    align-items: flex-end;
    gap: 8px;
  }

  .pwshowbutton {
    flex: 0 0 56px;
    min-width: 56px;
    padding: 4px 10px;
  }

  .login-submit {
    justify-content: stretch;
  }

  button.submitButton {
    width: 100%;
  }

  .login-actions {
    align-items: stretch;
  }
}
</style>

